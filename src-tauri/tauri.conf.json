{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Halite",
  "version": "0.1.0",
  "identifier": "com.halite.desktop",
  "build": {
    "frontendDist": "../src",
    "beforeDevCommand": "npm run prepare-assets",
    "beforeBuildCommand": "npm run prepare-assets"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Halite",
        "label": "main",
        "width": 1080,
        "height": 720,
        "minWidth": 820,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "transparent": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost; media-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'",
      "freezePrototype": true,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Music",
    "shortDescription": "Free & open-source AI music toolkit",
    "longDescription": "Halite is a free and open-source AI music toolkit. Separate any song into stems (vocals, drums, bass, other), download audio from supported sites, and view synchronized lyrics.",
    "copyright": "MIT License",
    "macOS": {
      "signingIdentity": "-"
    },
    "resources": {
      "resources/models/htdemucs.onnx": "models/htdemucs.onnx",
      "resources/models/htdemucs_fp16weights.onnx": "models/htdemucs_fp16weights.onnx",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
