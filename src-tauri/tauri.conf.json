{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Halite",
  "version": "0.1.0",
  "identifier": "com.halite.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Halite",
        "label": "main",
        "width": 1080,
        "height": 720,
        "minWidth": 820,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "transparent": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Music",
    "shortDescription": "Free & open-source AI music toolkit",
    "longDescription": "Halite is a free and open-source AI music toolkit. Separate any song into stems (vocals, drums, bass, other), download audio from supported sites, and view synchronized lyrics.",
    "copyright": "MIT License",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
